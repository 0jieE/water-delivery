# Backend API. Default for `npm run dev` is the local backend:
VITE_API_URL=http://localhost:8000/api
# To develop against the deployed backend instead, put this in a (git-ignored) .env:
# VITE_API_URL=https://deep-water.onrender.com/api
# `npm run build` already uses the deployed URL via .env.production.

# Maps (all optional). Defaults use the free public Nominatim + OSRM servers, which are fine for
# development and a capstone demo but not for production traffic: self-host or swap them for a
# commercial provider before launch.
# VITE_GEOCODER_URL=https://nominatim.openstreetmap.org
# VITE_ROUTING_URL=https://router.project-osrm.org

# Coordinates of the refilling station. When set, customer/staff order pages also show the road
# distance and time from the station to the delivery address.
# VITE_STATION_LAT=7.0083
# VITE_STATION_LNG=125.0894
